generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  clerk_id  String  @unique
  firstName String?
  lastName  String?
  email     String? @unique
  role      Role    @default(STUDENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id           String @id @default(uuid())
  firstName    String
  lastName     String
  age          Int
  email        String @unique
  phone        String
  address      String
  valid_id_URL String
  selfie_URL   String

  course_id String?
  course    Course? @relation(fields: [course_id], references: [id])

  schedule Schedule?

  status   StudentStatus @default(PENDING)
  //TODO FIX INVOICES TO INVOICE
  invoices Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String     @id @default(uuid())
  courseTitle String     @unique
  courseCode  CourseCode @default(TDC)
  description String
  price       Int        @default(0)

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id         String @id @default(uuid())
  student_id String

  first_session  String?
  second_session String?
  third_session  String?

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate session for same student in one day for pdc
  @@unique([student_id])
}

model Invoice {
  id              String  @id @default(uuid())
  reference_id    String  @unique
  student_id      String  @unique
  amountPaid      Int     @default(0)
  payment_channel String?
  item            String
  price           Int

  student Student       @relation(fields: [student_id], references: [id], onDelete: Cascade)
  status  InvoiceStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Instructor {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String? @unique
  phone     String?
  address   String?
  bio       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InvoiceStatus {
  PENDING
  PAID //PAID IN INVOICE EVEN ITS PARTIAL
  FAILED
  EXPIRED

  //MANUAL MANAGE IN PAYMENT
  PARTIAL
  FULLY_PAID
}

enum StudentStatus {
  PENDING
  ENROLLED
  GRADUATED
  REJECTED
  CANCELLED
}

enum Role {
  ADMIN
  STUDENT
  INSTRUCTOR
}

enum CourseCode {
  TDC
  PDC
  FULL_PACKAGE
}
