
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  clerk_id  String   @unique
  firstName String?
  lastName  String?
  email     String?  @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                String            @id @default(uuid())
  firstName         String
  lastName          String
  age               Int
  email             String            @unique
  phone             String
  address           String
  valid_id_URL      String
  selfie_URL        String
  course_id         String?
  status            StudentStatus     @default(PENDING)
  certificateStatus CertificateStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  invoices          Invoice?
  schedule          Schedule?
  course            Course?           @relation(fields: [course_id], references: [id])
  certificate       Certicate?        @relation("StudentCertificate")
}

model Course {
  id          String    @id @default(uuid())
  courseTitle String    @unique
  courseCode  String
  description String
  features    String[]
  price       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  students    Student[]
}

model Certicate {
  id                 String  @id @default(uuid())
  student_id         String  @unique
  cert_control_no    String  @unique
  school_admintrator String?

  student Student @relation("StudentCertificate", fields: [student_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id             String  @id @default(uuid())
  student_id     String  @unique
  first_session  String?
  second_session String?
  third_session  String?

  first_instructor_id  String?
  second_instructor_id String?
  third_instructor_id  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  first_instructor  Instructor? @relation("FirstInstructor", fields: [first_instructor_id], references: [id], onDelete: Cascade)
  second_instructor Instructor? @relation("SecondInstructor", fields: [second_instructor_id], references: [id], onDelete: Cascade)
  third_instructor  Instructor? @relation("ThirdInstructor", fields: [third_instructor_id], references: [id], onDelete: Cascade)
}

//TODO use reference id for getting each student schedule 
model Invoice {
  id              String        @id @default(uuid())
  reference_id    String        @unique
  student_id      String        @unique
  amountPaid      Int           @default(0)
  payment_channel String?
  item            String
  price           Int
  status          InvoiceStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  student         Student       @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model Instructor {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?  @unique
  phone     String?
  address   String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image_URL String?

  firstSchedules  Schedule[] @relation("FirstInstructor")
  secondSchedules Schedule[] @relation("SecondInstructor")
  thirdSchedules  Schedule[] @relation("ThirdInstructor")
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  PARTIAL
  FULLY_PAID
}

enum StudentStatus {
  PENDING
  ENROLLED
  GRADUATED
  REJECTED
  CANCELLED
}

enum Role {
  ADMIN
  STUDENT
  INSTRUCTOR
}

enum CourseCode {
  TDC
  PDC
  FULL_PACKAGE
}

enum CertificateStatus {
  PENDING
  GENERATED
}
