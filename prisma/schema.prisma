generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @unique
  email     String?  @unique
  role      Role     @default(student)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // student Student? @relation("UserStudent")
}

model Student {
  id           String @id @default(uuid())
  first_name   String
  last_name    String
  age          Int
  email        String @unique
  phone        String
  address      String
  valid_id_URL String
  selfie_URL   String

  course     String
  course_key String

  schedule Schedule?

  status   StudentStatus @default(PENDING)
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id         String @id @default(uuid())
  student_id String

  first_session  String?
  second_session String?
  third_session  String?

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate session for same student in one day
  @@unique([student_id])
}

model Invoice {
  id              String  @id @default(uuid())
  reference_id    String  @unique
  studentId       String
  student         Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ammountPaid     Int     @default(0)
  payment_channel String?
  item            String
  price           Int

  status InvoiceStatus @default(PENDING)

  dueDate DateTime? @default(now())
  paidAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// enum SessionNo {
//   FIRST
//   SECOND
//   THIRD
// }

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum StudentStatus {
  PENDING
  ENROLLED
  REJECTED
  CANCELLED
}

enum Role {
  admin
  student
}
