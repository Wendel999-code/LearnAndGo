generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(uuid())
  clerk_id  String   @unique
  firstName String?
  lastName  String?
  email     String?  @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  age          Int
  email        String        @unique
  phone        String
  address      String
  valid_id_URL String
  selfie_URL   String
  course_id    String?
  status       StudentStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoices     Invoice?
  schedule     Schedule?
  course       Course?       @relation(fields: [course_id], references: [id])
}

model Course {
  id          String    @id @default(uuid())
  courseTitle String    @unique
  courseCode  String
  description String
  features    String[]
  price       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  students    Student[]
}

model Schedule {
  id             String   @id @default(uuid())
  student_id     String   @unique
  instructor_id  String?
  first_session  String?
  second_session String?
  third_session  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student    Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)
  instructor Instructor? @relation(fields: [instructor_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "intructor_id_fkey")
}

//TODO use reference id for getting each student schedule 
model Invoice {
  id              String        @id @default(uuid())
  reference_id    String        @unique
  student_id      String        @unique
  amountPaid      Int           @default(0)
  payment_channel String?
  item            String
  price           Int
  status          InvoiceStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  student         Student       @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model Instructor {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  email     String?    @unique
  phone     String?
  address   String?
  bio       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  image_URL String?
  schedule  Schedule[]
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  PARTIAL
  FULLY_PAID
}

enum StudentStatus {
  PENDING
  ENROLLED
  GRADUATED
  REJECTED
  CANCELLED
}

enum Role {
  ADMIN
  STUDENT
  INSTRUCTOR
}

enum CourseCode {
  TDC
  PDC
  FULL_PACKAGE
}
